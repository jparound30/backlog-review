{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "build/scripts",
    "rewriteRelativeImportExtensions": true,
    "removeComments": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
